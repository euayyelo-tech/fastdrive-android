<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Phase 4 Task 4: only needed so WifiInfo.getSSID() (read via
         NetworkCapabilities.getTransportInfo() in WifiResumeWatcher) returns the real SSID instead
         of "<unknown ssid>" — required for the specific-Wi-Fi pause-resume condition, not for
         "any Wi-Fi". Requested at runtime only when the user picks that condition. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <application
        android:allowBackup="false"
        android:label="FastDrive"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".sync.InstantSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
